<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="view-root"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.g15.dsa.controller.DispatchController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14">
        <Label text="🚚" style="-fx-font-size: 30px;"/>
        <VBox spacing="2">
            <Label text="Dispatch &amp; Routing Centre" styleClass="view-title"/>
            <Label text="Dijkstra Shortest-Path Routing • Live Accra/Legon Substation Network" styleClass="view-subtitle"/>
        </VBox>
    </HBox>

    <!-- ROUTE CONTROLS -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="6" prefWidth="220">
            <Label text="From Substation:" style="-fx-font-size:12px; -fx-text-fill: #94a3b8;"/>
            <ComboBox fx:id="cbSource" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6" prefWidth="220">
            <Label text="To Substation:" style="-fx-font-size:12px; -fx-text-fill: #94a3b8;"/>
            <ComboBox fx:id="cbTarget" maxWidth="Infinity"/>
        </VBox>
        <VBox alignment="BOTTOM_LEFT">
            <Button fx:id="btnRoute" text="⚡  Find Shortest Route" onAction="#onRoute" styleClass="btn-primary"/>
        </VBox>
        <VBox alignment="BOTTOM_LEFT">
            <Button text="↺  Reset" onAction="#onReset" styleClass="btn-secondary"/>
        </VBox>
    </HBox>

    <!-- NETWORK MAP LABEL -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="kpi-row">
        <VBox styleClass="kpi-card" prefWidth="180" alignment="CENTER">
            <Label text="VERTICES" styleClass="kpi-label"/>
            <Label fx:id="lblVertices" text="5" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="kpi-card" prefWidth="180" alignment="CENTER">
            <Label text="EDGES" styleClass="kpi-label"/>
            <Label fx:id="lblEdges" text="8" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="kpi-card" prefWidth="180" alignment="CENTER">
            <Label text="ROUTE DISTANCE" styleClass="kpi-label"/>
            <Label fx:id="lblDistance" text="—" styleClass="kpi-value" style="-fx-text-fill:#22d3ee;"/>
        </VBox>
        <VBox styleClass="kpi-card" prefWidth="180" alignment="CENTER">
            <Label text="HOPS" styleClass="kpi-label"/>
            <Label fx:id="lblHops" text="—" styleClass="kpi-value" style="-fx-text-fill:#a78bfa;"/>
        </VBox>
    </HBox>

    <!-- OUTPUT AREA -->
    <TextArea fx:id="routeOutput" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
              styleClass="defense-output"
              promptText="Select source and destination substations, then click 'Find Shortest Route'…"/>

</VBox>
