<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.g15.dsa.controller.EditFaultController"
      spacing="16"
      prefWidth="480"
      styleClass="modal-dialog">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="Update Fault Record" styleClass="modal-title"/>
    <Label text="Modify outage properties, crew assignment, or resolution status." styleClass="modal-subtitle"/>

    <GridPane hgap="12" vgap="14">
        <Label text="Location / Substation:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
        <ComboBox fx:id="locationBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Fault Category:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
        <ComboBox fx:id="categoryBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Priority / Urgency:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-label"/>
        <ComboBox fx:id="urgencyBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Assigned Crew:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-label"/>
        <ComboBox fx:id="crewBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="form-label"/>
        <ComboBox fx:id="statusBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Region prefHeight="10"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" onAction="#closeWindow" styleClass="btn-secondary"/>
        <Button text="Update Record" onAction="#updateFault" styleClass="btn-primary"/>
    </HBox>

</VBox>
