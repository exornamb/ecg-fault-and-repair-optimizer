<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.FaultManagementController"
            stylesheets="@../../css/style.css"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="dashboard-scroll">

    <content>

        <VBox spacing="22"
              fillWidth="true">

            <padding>
                <Insets top="28"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>


            <!-- ==========================================
                 PAGE HEADER
                 ========================================== -->

            <VBox spacing="4">

                <Label text="Fault Management"
                       styleClass="dashboard-heading"/>

                <Label text="Manage, monitor and update reported electrical faults."
                       styleClass="page-subtitle"/>

            </VBox>


            <!-- ==========================================
                 SEARCH / FILTER / ACTION BAR
                 ========================================== -->

            <HBox spacing="12"
                  alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search Fault ID, Area, Category or Crew..."
                           styleClass="search-field"
                           prefWidth="330"
                           prefHeight="42"
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="priorityFilter"
                          promptText="Priority"
                          prefWidth="160"
                          minWidth="160"
                          prefHeight="42"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Status"
                          prefWidth="160"
                          minWidth="160"
                          prefHeight="42"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Edit"
                        prefWidth="75"
                        minWidth="75"
                        prefHeight="42"
                        styleClass="secondary-button"
                        onAction="#editFault"/>

                <Button text="Delete"
                        prefWidth="85"
                        minWidth="85"
                        prefHeight="42"
                        styleClass="danger-button"
                        onAction="#deleteFault"/>

                <Button text="+ Add New Fault"
                        prefWidth="145"
                        minWidth="145"
                        prefHeight="42"
                        styleClass="primary-button"
                        onAction="#addFault"/>

            </HBox>


            <!-- ==========================================
                 FAULT TABLE
                 ========================================== -->

            <VBox spacing="15"
                  styleClass="content-card"
                  minHeight="520">

                <!-- TABLE HEADER -->

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label text="Reported Faults"
                               styleClass="section-title"/>

                        <Label text="Select a fault to edit or delete it"
                               styleClass="card-subtitle"/>

                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Label fx:id="faultCountLabel"
                           text="0 faults"
                           styleClass="card-subtitle"/>

                </HBox>


                <!-- TABLE -->

                <TableView fx:id="faultTable"
                           prefHeight="450"
                           minHeight="400">

                    <columns>

                        <TableColumn
                                fx:id="faultIdColumn"
                                text="Fault ID"
                                prefWidth="110"
                                minWidth="100"/>

                        <TableColumn
                                fx:id="areaColumn"
                                text="Area"
                                prefWidth="170"
                                minWidth="140"/>

                        <TableColumn
                                fx:id="categoryColumn"
                                text="Category"
                                prefWidth="180"
                                minWidth="150"/>

                        <TableColumn
                                fx:id="priorityColumn"
                                text="Priority"
                                prefWidth="120"
                                minWidth="100"/>

                        <TableColumn
                                fx:id="crewColumn"
                                text="Assigned Crew"
                                prefWidth="170"
                                minWidth="140"/>

                        <TableColumn
                                fx:id="statusColumn"
                                text="Status"
                                prefWidth="120"
                                minWidth="100"/>

                    </columns>

                </TableView>


                <!-- TABLE FOOTER -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <Label text="Fault Management"
                           styleClass="card-title"/>

                    <Label text="Use the search and filters above to locate specific faults."
                           styleClass="card-subtitle"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Label text="Operational Dataset"
                           styleClass="card-subtitle"/>

                </HBox>

            </VBox>

        </VBox>

    </content>

</ScrollPane>