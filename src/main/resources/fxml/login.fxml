<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LoginController"
            stylesheets="@../css/style.css"
            style="-fx-background-color:#EDF2F7;">

    <center>

        <HBox alignment="CENTER"
              spacing="70">

            <padding>
                <Insets top="40"
                        right="60"
                        bottom="40"
                        left="60"/>
            </padding>

            <!-- =====================================
                 LEFT PANEL
                 ===================================== -->

            <VBox spacing="20"
                  alignment="CENTER_LEFT"
                  prefWidth="500">

                <ImageView fitWidth="180"
                           fitHeight="180"
                           preserveRatio="true">

                    <image>
                        <Image url="@../images/ecg-logo.jpg"/>
                    </image>

                </ImageView>

                <Label text="ECG SMART DISPATCH"
                       style="-fx-font-size:40;
                              -fx-font-weight:900;
                              -fx-text-fill:#233447;"/>

                <Label text="Electrical Fault Management &amp; Intelligent Resource Dispatch Platform"
                       wrapText="true"
                       maxWidth="430"
                       style="-fx-font-size:18;
                              -fx-text-fill:#64748B;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Powering smarter operations."
                       style="-fx-font-size:16;
                              -fx-font-weight:bold;
                              -fx-text-fill:#2F855A;"/>

            </VBox>

            <!-- =====================================
                 LOGIN CARD
                 ===================================== -->

            <VBox spacing="18"
                  alignment="CENTER"
                  maxWidth="430"
                  minWidth="430"
                  styleClass="card">

                <padding>
                    <Insets top="45"
                            right="45"
                            bottom="45"
                            left="45"/>
                </padding>

                <Label text="Welcome Back"
                       styleClass="title"/>

                <Label text="Sign in to continue"
                       styleClass="subtitle"/>

                <TextField promptText="Username"
                           maxWidth="320"/>

                <PasswordField promptText="Password"
                               maxWidth="320"/>

                <HBox alignment="CENTER_LEFT"
                      maxWidth="320">

                    <CheckBox text="Remember Me"/>

                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label text="Forgot Password?"
                           style="-fx-text-fill:#2F855A;
                                  -fx-font-weight:bold;"/>

                </HBox>

                <Button fx:id="loginButton"
                        text="SIGN IN"
                        onAction="#handleLogin"
                        maxWidth="320"
                        prefHeight="48"
                        styleClass="primary-button"/>

                <Separator/>

                <Label text="Electricity Company of Ghana"
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-size:13;"/>

                <Label text="Version 1.0"
                       style="-fx-text-fill:#CBD5E1;
                              -fx-font-size:12;"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>

