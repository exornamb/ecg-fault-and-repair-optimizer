<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.g15.dsa.controller.FaultManagementController"
      spacing="16"
      styleClass="view-container">

    <!-- HEADER TITLE & ACTIONS -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Fault Incident Management" styleClass="view-title"/>
            <Label fx:id="totalFaultsCountLabel" text="Total Records: 0" styleClass="view-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⚡  Auto Dispatch Crew" onAction="#handleAutoDispatch" styleClass="btn-accent"/>
        <Button text="✏  Edit Selected" onAction="#openEditFaultModal" styleClass="btn-secondary"/>
        <Button text="🗑  Delete" onAction="#handleDeleteFault" styleClass="btn-danger"/>
        <Button text="➕  Report New Fault" onAction="#openAddFaultModal" styleClass="btn-primary"/>
    </HBox>

    <!-- SEARCH & FILTER TOOLBAR -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-card">
        <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
        </padding>

        <TextField fx:id="searchField" promptText="🔍  Search by ID, Area, Crew, or Status..." prefWidth="300" styleClass="search-field"/>

        <Label text="Category:" styleClass="filter-label"/>
        <ComboBox fx:id="categoryFilter" prefWidth="170" styleClass="filter-combo"/>

        <Label text="Priority:" styleClass="filter-label"/>
        <ComboBox fx:id="priorityFilter" prefWidth="140" styleClass="filter-combo"/>

        <Label text="Status:" styleClass="filter-label"/>
        <ComboBox fx:id="statusFilter" prefWidth="130" styleClass="filter-combo"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Refresh" onAction="#refreshTable" styleClass="btn-ghost"/>
    </HBox>

    <!-- FAULT DATA TABLE -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>
        <TableView fx:id="faultTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="faultIdColumn" text="Fault ID" prefWidth="100"/>
                <TableColumn fx:id="areaColumn" text="Substation / Geographical Location" prefWidth="240"/>
                <TableColumn fx:id="categoryColumn" text="Fault Category" prefWidth="180"/>
                <TableColumn fx:id="priorityColumn" text="Urgency Level" prefWidth="130"/>
                <TableColumn fx:id="crewColumn" text="Assigned Repair Unit" prefWidth="200"/>
                <TableColumn fx:id="statusColumn" text="Current Status" prefWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
